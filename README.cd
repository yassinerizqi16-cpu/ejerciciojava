        System.out.println();
        //condicion de par y mayor que 10:
        for (int i = 0;i < nums.length;i++){
            if(nums[i] % 2 == 0 && nums[i] > 10){
                cont++;
            }
        }
        System.out.println("los numeros pares y mayor de diez son : "  + cont);
